# Copy to .env in this directory. Never paste credentials into chat.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Obtain the following IDs using the explicit discover command (see README).
FEISHU_ALLOWED_TENANT=
FEISHU_BOT_OPEN_ID=
FEISHU_ALLOWED_USERS=
FEISHU_ALLOWED_CHATS=
# Comma-separated open_id / chat_id lists; BOTH sender and group must be allowed.
MEDICAL_API_BASE_URL=http://127.0.0.1:8000
MAX_INPUT_CHARS=4000
MAX_QUEUE_SIZE=10
MAX_PENDING_REPLIES=50
QUEUE_WAIT_SECONDS=300
MEDICAL_TIMEOUT_SECONDS=180
# Relative paths resolve against THIS file's directory.
STATE_DB_PATH=runtime/state.sqlite3
